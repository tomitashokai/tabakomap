# タバコマップの環境変数テンプレート。値は入れないこと（このファイルはコミットされる）。
#
# ローカル: このファイルを .env.local にコピーして値を入れる
# クラウドセッション (claude.ai/code): Cloud environment の環境変数に設定する
#   https://claude.ai/code → 環境設定 → Environment variables

# --- アプリの実行に必須 ---
# 地図の描画。これが無いと /map が真っ白になる
NEXT_PUBLIC_MAPBOX_TOKEN=
# Supabase のプロジェクト URL（https://<ref>.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=
# Supabase の anon key。RLS を張ってあるので公開されて問題ない前提だが、リポジトリには入れない
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- スクリプトの実行に必要（アプリ本体には不要） ---
# Supabase Management API のトークン。scripts/import-brands.mjs と
# scripts/import-osaka-shops.mjs が DB へ書き込むのに使う。
# postgres 権限で走り RLS を素通りするので取り扱い注意
SUPABASE_ACCESS_TOKEN=

# scripts/import-osaka.mjs（大阪市指定喫煙所 CSV の投入）だけが使う。
# 通常の作業では不要
SUPABASE_SERVICE_ROLE_KEY=
