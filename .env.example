# タバコマップの環境変数テンプレート。値は入れないこと（このファイルはコミットされる）。
#
# ローカル: このファイルを .env.local にコピーして値を入れる
#
# クラウドセッション (claude.ai/code): Cloud environment の環境変数に設定する。
#   ただし **Cloud environment に専用のシークレットストアは無く、その環境を使う人は
#   誰でも値を読める**。入れてよいのは下の「アプリの実行に必須」の3つだけ。
#   いずれも next build でクライアントバンドルに埋め込まれ、本番サイトから
#   誰でも読める前提のものなので、クラウドに置いても新たな露出は生まない。
#   SUPABASE_ACCESS_TOKEN と SUPABASE_SERVICE_ROLE_KEY は入れないこと。

# --- アプリの実行に必須（NEXT_PUBLIC_* は公開前提） ---
# 地図の描画。これが無いと /map が真っ白になる
NEXT_PUBLIC_MAPBOX_TOKEN=
# Supabase のプロジェクト URL（https://<ref>.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=
# Supabase の anon key。RLS を張ってあるので公開されて問題ない前提だが、リポジトリには入れない
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- 任意（未設定でも動く） ---
# GA4 の測定 ID（G-XXXXXXXXXX）。未設定なら計測タグを描画しない。
# ローカルには入れないこと。自分のアクセスが本番の数値に混ざる
NEXT_PUBLIC_GA_ID=

# --- スクリプトの実行に必要（アプリ本体には不要・クラウドには置かない） ---
# Supabase Management API のトークン。scripts/import-brands.mjs と
# scripts/import-osaka-shops.mjs が DB へ書き込むのに使う。
# postgres 権限で走り RLS を素通りする。Supabase アカウント配下の他プロジェクトにも
# 及ぶので、クラウドセッションには置かずローカルだけで持つこと
SUPABASE_ACCESS_TOKEN=

# scripts/import-osaka.mjs（大阪市指定喫煙所 CSV の投入）だけが使う。
# 通常の作業では不要。これもクラウドには置かない
SUPABASE_SERVICE_ROLE_KEY=
